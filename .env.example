# Illustrative names only. Never commit a populated .env file.
# MOSSO_LISTEN=127.0.0.1:8080   (loopback only; non-loopback addresses are refused)
#
# Vercel Sandbox (see docs/vercel-sandbox.md). All three are required to enable
# the /sandboxes endpoints.
# VERCEL_TOKEN=replace-locally
# VERCEL_TEAM_ID=team_replace-locally
# VERCEL_PROJECT_ID=prj_replace-locally
#
# Claude Code (see docs/claude-code.md). On macOS prefer `mosso auth claude`,
# which stores the token in the Keychain; this variable is the fallback.
# CLAUDE_CODE_OAUTH_TOKEN=replace-locally
#
# GITHUB_TOKEN=replace-locally
# Model provider credentials are configured locally for Pi.
